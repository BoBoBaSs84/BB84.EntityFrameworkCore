<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>True</ManagePackageVersionsCentrally>
		<CentralPackageTransitivePinningEnabled>True</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Only for projects not on MSTest.Sdk, which declares this version itself.
         Keep in sync with MSTest.Sdk in global.json. -->
    <PackageVersion Include="MSTest.TestFramework" Version="4.5.2" Condition="'$(UsingMSTestSdk)' != 'true'" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.16.0" />
		<PackageVersion Include="System.Security.Cryptography.Pkcs" Version="9.0.22"/>
  </ItemGroup>
</Project>